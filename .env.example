# Get a free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# moomoo OpenD(期权链)
MOOMOO_WS_HOST=127.0.0.1
MOOMOO_WS_PORT=33333
MOOMOO_WS_KEY=

# scripts/daily-with-opend.sh 用:headless 拉起命令行版 OpenD(留空=只在 OpenD 已运行时跑)。
# 用命令行版二进制(OpenD,非 GUI 的 moomoo_OpenD)。值带空格,整体用双引号包起来。
# 新设备首次登录要手机验证码;图形验证码仅在"多次输错密码"后才触发。
# -telnet_port=22222 开命令端口:万一要验证码,可 telnet 进去 input_pic_verify_code/input_phone_verify_code 喂码。
# OPEND_CMD="/路径/OpenD.app/Contents/MacOS/OpenD -login_account=XXXX -login_pwd_md5=XXXX -lang=en -log_level=no -console=0 -no_monitor=1 -telnet_port=22222"
OPEND_CMD=

# SEC XBRL(公司基本面)。SEC 强制要求 User-Agent 带真实联系方式,否则 403。
# 格式:「应用名 邮箱」,如 my-trading-view someone@example.com。**必须填真实联系方式**,
# 假邮箱有被 SEC 封 IP 的风险。留空则每家抓取都抛错 → job 记 failed(状态灯红),不会静默用假 UA。
SEC_USER_AGENT=

# 韩国 DART OpenAPI(SK 海力士的毛利率 / FCF —— 它的 SEC 侧只有营收与营业利润,算不出这两个)。
# 免费:opendart.fss.or.kr 注册,选**개인/Individual**(只要 email、无手机验证),提交即时发 40 位 key。
# 法人申请才要韩国营业执照与联系电话,别选错。
# 限额 20,000 次/日。留空则海力士那条线整个跳过(不影响其它公司)。
DART_API_KEY=

# 日本 EDINET API v2(东京电子等日本发行人的基本面 —— 它们在 SEC 侧只有 F-6 ADR 注册,
# 零 20-F / 零 6-K / 零财务 XBRL,和 SK 海力士同一类)。
# 免费:https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1 填姓名 + 邮箱 + 电话,
# 邮件验证码后当场发 32 位 key。⚠️ 最后一步走弹窗,先允许 api.edinet-fsa.go.jp 的弹窗。
# ⚠️ 日本 2024-04-01 起废止四半期報告書:EDINET 从此只有半期(H1)+ 年度,一年两个点;
# 2024 之前才有季度。季度数据在 TDnet 的決算短信里,那是另一个源、且只留存约 31 天(不可回填)。
# 留空则日本发行人那几条线整个跳过(不影响其它公司)。
EDINET_API_KEY=
