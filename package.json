{
  "name": "my-trading-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta --kill-others-on-fail \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "job:daily": "bun run src/server/jobs/daily.ts",
    "job:daily:opend": "scripts/daily-with-opend.sh",
    "job:crypto": "bun run src/server/jobs/cryptoDaily.ts",
    "job:sec": "bun run src/server/jobs/aiChainFundamentals.ts",
    "db:migrate": "bun run src/server/storage/db.ts migrate",
    "test": "bun test",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "bun node_modules/typescript/lib/tsc.js --noEmit",
    "check": "bun run typecheck && bun test && bun run lint",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && ! git config core.hooksPath >/dev/null && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "moomoo-api": "^10.9.6908",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "remeda": "^2.58.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "fancy-canvas": "2.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
